# B1：HTTPS 站点模板（拿到域名 + 证书后启用）
# 启用步骤见同目录 README.md「HTTPS 签发与启用」。用本文件替换 yumu.conf 中的 server 块。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 80 端口只做两件事：ACME 验证 + 全部 301 到 https
server {
    listen 80;
    server_name your-domain.com;          # TODO: 换成你的域名
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name your-domain.com;          # TODO: 换成你的域名

    # certbot webroot 签发的证书路径（容器内需挂载 /etc/letsencrypt 与 /var/www/certbot）
    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;   # TODO: 域名
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;     # TODO: 域名

    # TLS 安全基线
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 10m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    location /api/ws {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
