# ============================================================
# 依赖与构建产物
# ============================================================
node_modules/
frontend/node_modules/
backend/target/
target/
frontend/dist/
dist/
dist.old.*/
dist_fresh/
dist_new/
# `npm run build` 清 dist 会被宿主的批量删除守卫拦（SAFE_DELETE_BULK_CONFIRM_REQUIRED），
# 惯例做法是先 Move-Item dist dist_bak —— 那是本地临时产物，一律不入库
dist_bak*/
# 备份也可能被临时改名成 dist_916bak 之类（避开与上一次备份重名），一并忽略
dist_*/
# C 方案发版脚本在「dist 被占用」时自动挪成的备份（deploy/tools/deploy-local.sh）
dist.bak*/
*.jar

# ============================================================
# 运行时数据（用户上传 / 日志 / 探活状态 / 数据库备份）
# ============================================================
uploads/
backend/uploads/
*.log
logs/
.monitor-state/
# release.sh 的发版基线（记录上次发版成功的 sha）—— 机器本地状态，不入库
.deploy-state/
deploy/backup/backups/
# 数据库导出（含 user 表 email / 密码哈希）——绝不入库
db-backup/
*.sql.gz
*.dump
# 历史全量数据库 dump（含 user 表密码哈希）——仅留本地，绝不入库
/backend/pre-1.2-backup.sql

# ============================================================
# 密钥与环境（B4：生产密钥绝不入库）
# ============================================================
.env
.env.local
*.pem
*.key

# ============================================================
# 临时与编辑器
# ============================================================
# UI 回归脚本（playwright-core + 系统 Chrome）——脚本入库便于复现，只忽略依赖与调试截图
tests/.pw/node_modules/
tests/.pw/*.png
# vite 改配置时生成的临时文件
vite.config.js.timestamp-*.mjs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

